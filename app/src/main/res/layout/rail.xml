<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_tile">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_launcher" />
        </FrameLayout>

        <TextView
            style="@style/Text.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="28sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_settings"
            style="@style/Widget.Lookout.RailTab"
            android:text="@string/tab_settings"
            app:icon="@drawable/ic_tab_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_deliveries"
            style="@style/Widget.Lookout.RailTab"
            android:text="@string/tab_deliveries"
            app:icon="@drawable/ic_tab_deliveries" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_updates"
            style="@style/Widget.Lookout.RailTab"
            android:text="@string/tab_updates"
            app:icon="@drawable/ic_tab_updates" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/service_on_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/service_dot"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dot_success" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/service_enabled" />

                <TextView
                    android:id="@+id/service_detail"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/service_enabled_detail" />
            </LinearLayout>
        </LinearLayout>

        <!-- A switch, not a checkbox like the form's: it applies at once, without Save -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/reporting_toggle"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:nextFocusUp="@id/tab_updates"
            android:text="@string/label_reporting" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/service_off_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:backgroundTint="@color/warning_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="@color/warning"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="@string/service_not_enabled"
            android:textColor="@color/on_warning_container"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/service_disabled"
            android:textColor="@color/on_warning_container"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_accessibility"
            style="@style/Widget.Lookout.Button.Warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusUp="@id/tab_updates"
            android:text="@string/open_accessibility" />
    </LinearLayout>
</LinearLayout>
