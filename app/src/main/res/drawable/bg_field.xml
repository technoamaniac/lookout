<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/field_focused" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/surface_container_high" />
            <stroke android:width="2dp" android:color="@color/error" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface_container_high" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
