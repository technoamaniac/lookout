<?xml version="1.0" encoding="utf-8"?>
<!-- Which apps are never reported: a scrim over the whole screen and a sheet on the right, like the delivery filter.
     The scrim is meant to paint over the screen behind it, so the overdraw lint does not apply. The sheet may not
     clip its children (focus rings draw outside their views), so the list sits in a frame that clips what scrolls past
     the edges. The list's padding leaves the rings room inside that frame. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw"
    android:id="@+id/ignored_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="450dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="27dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="27dp"
        android:background="@drawable/bg_sheet_high"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ignored_title" />

            <TextView
                android:id="@+id/ignored_count"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent" />
        </LinearLayout>

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ignored_helper" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ignored_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="10dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ignored_done"
                style="@style/Widget.Lookout.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/filter_done"
                android:textSize="16sp" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/detail_back_hint" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
