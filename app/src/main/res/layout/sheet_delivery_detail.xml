<?xml version="1.0" encoding="utf-8"?>
<!-- Delivery details: a scrim over the whole screen and a sheet on the right. The scrim is meant to paint over
     the screen behind it, so the overdraw lint does not apply -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw"
    android:id="@+id/detail_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="450dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="27dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="27dp"
        android:background="@drawable/bg_sheet_high"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:baselineAligned="false"
    android:orientation="horizontal">

            <TextView
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/detail_title" />

            <TextView
                android:id="@+id/detail_result"
                style="@style/Widget.Lookout.Chip" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
    android:orientation="horizontal">

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="@string/detail_app" />

            <TextView
                android:id="@+id/detail_app"
                style="@style/Text.Mono"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
    android:orientation="horizontal">

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="@string/detail_attempted" />

            <TextView
                android:id="@+id/detail_time"
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
    android:orientation="horizontal">

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="@string/detail_response" />

            <TextView
                android:id="@+id/detail_response"
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/detail_payload" />

        <!-- The payload and the buttons share the height left over. The code box fits its text but
             stops 20dp above the buttons; past that its text scrolls inside it. Its own padding is
             what clips the text, since the sheet lets children draw outside for the focus rings. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Focusable so the remote can scroll a long payload -->
            <ScrollView
                android:id="@+id/detail_payload_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_code_scrollable"
                android:fadeScrollbars="false"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:scrollbarStyle="insideInset"
                android:scrollbars="vertical"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toTopOf="@id/detail_actions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0">

                <TextView
                    android:id="@+id/detail_payload"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/detail_actions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:baselineAligned="false"
        android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_close"
                    style="@style/Widget.Lookout.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/detail_close"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/detail_back_hint" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
