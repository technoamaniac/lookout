<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn only while focused, just outside the view; ancestors must not clip children -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="-5dp" android:left="-5dp" android:right="-5dp" android:top="-5dp">
                <shape>
                    <stroke android:width="3dp" android:color="@color/focus_ring" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
