<?xml version="1.0" encoding="utf-8"?>
<!-- A FrameLayout, not <merge>: one root holds the screen and the detail sheet. Children may not clip:
     focus rings and the focus scale draw outside their views. The rail, each tab and the sheet live in their
     own layouts, so a change to one stays in one file. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="MergeRootFrame">

    <!-- 5% overscan-safe margins -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <!-- Rail: brand, tabs and the service status -->
        <include layout="@layout/rail" />

        <!-- Content: the whole page scrolls as one, so the header never sits under the sheet. The
             sheet takes the leftover height (weight) so a short panel still fills the screen. -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:minHeight="54dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/panel_title"
                            style="@style/Text.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/panel_subtitle"
                            style="@style/Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Opens the delivery filter; shown only on the Deliveries tab, beside the title -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filter_button"
                        style="@style/Widget.Lookout.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="40dp"
                        android:text="@string/filter"
                        android:textSize="16sp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_filter" />

                    <!-- Corner alert for a new stable release; selecting it opens the Updates tab -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/update_badge"
                        style="@style/Widget.Lookout.Button.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_tab_updates" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sheet"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <include layout="@layout/panel_settings" />

                    <include layout="@layout/panel_deliveries" />

                    <include layout="@layout/panel_updates" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Delivery details: scrim over the screen and a sheet on the right -->
    <include layout="@layout/sheet_delivery_detail" />

    <!-- Delivery filter: the same scrim and sheet -->
    <include layout="@layout/sheet_delivery_filter" />
</FrameLayout>
